# ============================================================
# BookMosaic Server — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# --- Core (REQUIRED — server will not start without these) ---
NODE_ENV=development
PORT=1000
DB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/bookmosaic?retryWrites=true&w=majority
JWT_SECRET=<minimum-32-character-random-string>
FRONTEND_URL=http://localhost:5173
# For production (Render), use your deployed frontend origin(s) — comma-separated to allow multiple:
# FRONTEND_URL=https://mybookmosaic.netlify.app,http://localhost:5173

# --- Cashfree Payments (REQUIRED for payment endpoints to work) ---
CASHFREE_APP_ID=<your-cashfree-app-id>
CASHFREE_SECRET_KEY=<your-cashfree-secret-key>
CASHFREE_MODE=sandbox
# CASHFREE_MODE=production   <- switch to this when going live

# --- Email / Nodemailer (REQUIRED for transactional emails) ---
EMAIL_USER=youraddress@gmail.com
EMAIL_PASS=<gmail-app-password>

# --- Logging (production-level) ---
LOG_LEVEL=info
# LOG_LEVEL=debug   # use in development for verbose logs
# LOG_FILE=./logs/app.log  # optional: also write JSON logs to file
# LOG_FILE=/var/log/bookmosaic/app.log  # example for Linux prod

# --- Optional ---
BASE_URL=http://localhost:1000
WEBHOOK_URL=https://your-domain.com/api/v1/webhook
# UPLOAD_DIR=./uploads
# GOOGLE_CREDENTIALS=<base64-encoded-service-account-json>  # for Google Cloud Storage
